# Render Sandboxes (early access)
RENDER_API_KEY=
RENDER_WORKSPACE_ID=

# Cursor Enterprise service-account key with agent scope.
# This key remains in the local orchestrator and is never sent to the sandbox.
CURSOR_API_KEY=

# Existing named any-repository Team Pool. The runner retains this pool.
CURSOR_POOL=

# Optional overrides
# CURSOR_API_BASE_URL=https://api.cursor.com
# AGENT_TIMEOUT_SECONDS=600
